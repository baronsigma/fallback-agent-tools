# Public service origin used to generate absolute discovery URLs.
PUBLIC_BASE_URL=https://fallback.example
PORT=3000
NODE_ENV=development

# Deterministic discovery always runs first. Leave blank to prefer Tavily, then Brave, when keyed.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Payment configuration is intentionally unset in this scaffold.
# Configure an operator-controlled receiving address only during deployment.
X402_PAY_TO=
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional evaluation-only cost assumptions (USD per external search request).
EVAL_TAVILY_COST_PER_SEARCH=0
EVAL_BRAVE_COST_PER_SEARCH=0.005
