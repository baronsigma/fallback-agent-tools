# Required public service origin in production. For local development use http://localhost:3000.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Deterministic discovery always runs first. Leave blank to prefer Tavily, then Brave, when keyed.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# disabled: local/free execution; test: Base Sepolia; production: Base mainnet.
PAYMENT_MODE=disabled
X402_PAY_TO=
X402_NETWORK=
X402_FACILITATOR_URL=
# Optional facilitator auth header value, e.g. "Bearer …". Never commit a real value.
X402_FACILITATOR_AUTHORIZATION=

# Per-client in-memory limit; clients are identified by the direct socket address.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional evaluation-only cost assumptions (USD per external search request).
EVAL_TAVILY_COST_PER_SEARCH=0
EVAL_BRAVE_COST_PER_SEARCH=0.005
