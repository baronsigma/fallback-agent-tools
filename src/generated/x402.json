{
  "documentType": "fallback-owned-readiness-metadata",
  "protocolStandard": false,
  "note": "x402 payment requirements and Bazaar discovery extensions are returned by payable resource responses. This document is not a protocol-standard well-known endpoint.",
  "x402Version": 2,
  "service": {
    "name": "Fallback",
    "description": "Small pay-per-call utilities that resolve uncertainty for autonomous agents. source_route returns ranked candidate access routes, preferably authoritative and machine-readable where possible, within a bounded checked scope. Absence is not proof of nonexistence.",
    "resource": "https://factrail.online"
  },
  "paymentMode": "disabled",
  "bazaar": {
    "extension": "bazaar",
    "active": false
  },
  "resources": [
    {
      "id": "source_route",
      "resource": "https://factrail.online/v1/tools/source_route",
      "type": "http",
      "toolName": "source_route",
      "description": "Return ranked candidate access routes for obtaining information, preferably authoritative and machine-readable where possible, within a bounded checked scope. Absence is not proof of nonexistence. Bounded discovery with at most one external search fallback.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "format": "hostname",
            "pattern": "^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$"
          },
          "start_url": {
            "type": "string",
            "maxLength": 2048
          },
          "preferred_formats": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml",
                "rss",
                "api",
                "bulk_download",
                "html"
              ]
            }
          },
          "require_official": {
            "default": false,
            "type": "boolean"
          },
          "max_candidates": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "priceUsd": "0.02",
      "availability": "available",
      "enabled": true,
      "active": false
    }
  ]
}
