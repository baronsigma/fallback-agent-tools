{
  "x402Version": 2,
  "service": {
    "name": "Fallback",
    "description": "Small pay-per-call utilities that resolve uncertainty for autonomous agents. Don't spend a dollar of reasoning on a cent-sized problem.",
    "resource": "https://fallback.example"
  },
  "bazaar": {
    "extension": "bazaar",
    "configured": false
  },
  "resources": [
    {
      "id": "source_route",
      "resource": "https://fallback.example/v1/tools/source_route",
      "type": "http",
      "toolName": "source_route",
      "description": "Find a practical, preferably authoritative and machine-readable route for obtaining information. Bounded deterministic discovery with at most one external search fallback.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "format": "hostname",
            "pattern": "^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$"
          },
          "preferred_formats": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml",
                "rss",
                "api",
                "bulk_download",
                "html"
              ]
            }
          },
          "require_official": {
            "default": false,
            "type": "boolean"
          },
          "max_candidates": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "priceUsd": "0.02",
      "availability": "available",
      "enabled": false
    },
    {
      "id": "stop_search",
      "resource": "https://fallback.example/v1/tools/stop_search",
      "type": "http",
      "toolName": "stop_search",
      "description": "Determine whether a bounded search has gathered enough negative evidence to reasonably stop. Planned and unavailable.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "priceUsd": "0.02",
      "availability": "planned",
      "enabled": false
    },
    {
      "id": "error_route",
      "resource": "https://fallback.example/v1/tools/error_route",
      "type": "http",
      "toolName": "error_route",
      "description": "Classify an API or tool failure and recommend a bounded next action. Planned and unavailable.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "priceUsd": "0.002",
      "availability": "planned",
      "enabled": false
    }
  ]
}
