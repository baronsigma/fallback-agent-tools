{
  "productId": "fallback",
  "name": "Fallback",
  "description": "Small pay-per-call recovery utilities for autonomous agents.",
  "tagline": "Don't spend a dollar of reasoning on a cent-sized problem.",
  "version": "0.1.0-beta.1",
  "transports": {
    "http": "active",
    "mcp": "active",
    "payment": "disabled"
  },
  "payment": {
    "mode": "disabled",
    "x402": false
  },
  "endpoints": {
    "mcp": "https://fallback.test/mcp",
    "catalog": "https://fallback.test/catalog.json",
    "openapi": "https://fallback.test/openapi.json",
    "serverCard": "https://fallback.test/.well-known/mcp/server-card.json",
    "x402": "https://fallback.test/.well-known/x402.json",
    "skill": "https://fallback.test/skill.md"
  },
  "tools": [
    {
      "id": "source_route",
      "version": "0.1.0-beta.1",
      "name": "source_route",
      "description": "Find likely authoritative or machine-readable sources when you know what information you need but not where to retrieve it. Provide a goal and optional publisher domain or start URL; it returns ranked candidate routes and bounded evidence. Use it before blind searching. Do not use it when you already have the correct source or only need reasoning over supplied context.",
      "category": "source-discovery",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "format": "hostname",
            "pattern": "^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$"
          },
          "start_url": {
            "type": "string",
            "maxLength": 2048
          },
          "preferred_formats": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml",
                "rss",
                "api",
                "bulk_download",
                "html"
              ]
            }
          },
          "require_official": {
            "default": false,
            "type": "boolean"
          },
          "max_candidates": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "routes_found",
              "no_suitable_route_found",
              "insufficient_input"
            ]
          },
          "routes": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "route_type": {
                  "type": "string",
                  "enum": [
                    "official_api",
                    "openapi",
                    "bulk_download",
                    "structured_feed",
                    "dataset",
                    "developer_docs",
                    "structured_web",
                    "web"
                  ]
                },
                "format": {
                  "type": "string"
                },
                "publisher_match": {
                  "type": "string",
                  "enum": [
                    "exact_domain",
                    "same_site",
                    "linked_from_domain",
                    "search_discovered"
                  ]
                },
                "verification": {
                  "type": "string",
                  "enum": [
                    "content_verified",
                    "publisher_linked",
                    "search_only"
                  ]
                },
                "machine_readable": {
                  "type": "boolean"
                },
                "auth": {
                  "type": "string",
                  "enum": [
                    "none_observed",
                    "appears_required",
                    "unknown"
                  ]
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Bounded route-ranking value combining publisher relationship, route semantics, goal relevance, format preference, and observed authentication. Not a probability or confidence estimate."
                },
                "reasons": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "url",
                "route_type",
                "publisher_match",
                "verification",
                "machine_readable",
                "auth",
                "score",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "checked": {
            "type": "object",
            "properties": {
              "direct_probes": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pages_fetched": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "search_queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "direct_probes",
              "pages_fetched",
              "search_queries"
            ],
            "additionalProperties": false
          },
          "limitations": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "routes",
          "checked",
          "limitations"
        ],
        "additionalProperties": false
      },
      "price": {
        "amount": "0.02",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "available",
      "httpRoute": "/v1/tools/source_route",
      "mcpName": "source_route",
      "examples": [
        {
          "title": "Find a machine-readable route",
          "input": {
            "goal": "Download the latest population dataset",
            "domain": "statistics.example"
          },
          "expected": "routes_found or no_suitable_route_found within checked scope"
        }
      ],
      "latencyTargetMs": 12000,
      "x402": {
        "resourceType": "http",
        "enabled": true,
        "discoveryExtension": "bazaar",
        "active": false
      },
      "distribution": {
        "apifyActorId": "fallback/source-route",
        "smitheryServerId": "source_route",
        "glamaServerId": "source_route"
      }
    },
    {
      "id": "stop_search",
      "version": "0.1.0-beta.1",
      "name": "stop_search",
      "description": "Determine whether a bounded search has gathered enough negative evidence to reasonably stop. Planned and unavailable.",
      "category": "search-quality",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": {}
      },
      "price": {
        "amount": "0.02",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "planned",
      "httpRoute": "/v1/tools/stop_search",
      "mcpName": "stop_search",
      "examples": [
        {
          "title": "Planned schema placeholder",
          "input": {}
        }
      ],
      "latencyTargetMs": 1000,
      "x402": {
        "resourceType": "http",
        "enabled": false,
        "discoveryExtension": "bazaar",
        "active": false
      },
      "distribution": {
        "apifyActorId": "fallback/stop-search",
        "smitheryServerId": "stop_search",
        "glamaServerId": "stop_search"
      }
    },
    {
      "id": "error_route",
      "version": "0.1.0-beta.1",
      "name": "error_route",
      "description": "Diagnose a failed API, HTTP, MCP, or tool request and return a structured, bounded next action. Use it after a request fails instead of repeatedly retrying or spending a large reasoning loop diagnosing common errors. Provide a status, response, or error text; it does not execute requests or verify undocumented fixes.",
      "category": "recovery",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "request": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "maxLength": 16
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "body": {}
            },
            "additionalProperties": false
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "body": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "additionalProperties": false
          },
          "error": {
            "type": "string",
            "maxLength": 2048
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "authentication_required",
              "authorization_denied",
              "rate_limited",
              "quota_exhausted",
              "payment_required",
              "payment_failed",
              "schema_mismatch",
              "invalid_input",
              "not_found",
              "method_not_allowed",
              "unsupported_media_type",
              "timeout",
              "connection_failure",
              "dns_failure",
              "tls_failure",
              "upstream_failure",
              "service_unavailable",
              "conflict",
              "stale_state",
              "malformed_response",
              "blocked_or_challenged",
              "unknown"
            ]
          },
          "retry": {
            "type": "string",
            "enum": [
              "never",
              "immediate",
              "after_delay",
              "after_change",
              "after_auth",
              "after_payment",
              "unknown"
            ]
          },
          "safe_to_retry": {
            "type": "boolean"
          },
          "next_action": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "modify_request",
                  "inspect_schema",
                  "wait",
                  "authenticate",
                  "change_endpoint",
                  "reduce_rate",
                  "pay",
                  "stop_retrying",
                  "escalate",
                  "unknown"
                ]
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "changes": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 160
                }
              }
            },
            "required": [
              "type",
              "instruction",
              "changes"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "signal": {
                  "type": "string",
                  "maxLength": 40
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 160
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [
                "signal",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "limits": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 180
            }
          },
          "tool_version": {
            "type": "string"
          }
        },
        "required": [
          "classification",
          "retry",
          "safe_to_retry",
          "next_action",
          "confidence",
          "evidence",
          "limits",
          "tool_version"
        ],
        "additionalProperties": false
      },
      "price": {
        "amount": "0.002",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "available",
      "httpRoute": "/v1/tools/error_route",
      "mcpName": "error_route",
      "examples": [
        {
          "title": "Diagnose a request schema error",
          "input": {
            "goal": "Retrieve a company profile",
            "request": {
              "method": "POST",
              "url": "https://api.example/company"
            },
            "response": {
              "status": 400,
              "body": "current_company_domain is not a valid field"
            }
          },
          "expected": "schema_mismatch with inspect_schema guidance"
        }
      ],
      "latencyTargetMs": 50,
      "x402": {
        "resourceType": "http",
        "enabled": true,
        "discoveryExtension": "bazaar",
        "active": false
      },
      "distribution": {
        "apifyActorId": "fallback/error-route",
        "smitheryServerId": "error_route",
        "glamaServerId": "error_route"
      }
    },
    {
