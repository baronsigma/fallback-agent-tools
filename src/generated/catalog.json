{
  "name": "Fallback",
  "description": "Small pay-per-call utilities that resolve uncertainty for autonomous agents. Don't spend a dollar of reasoning on a cent-sized problem.",
  "version": "0.1.0",
  "transports": {
    "http": "active",
    "mcp": "inactive",
    "payment": "disabled"
  },
  "endpoints": {
    "mcp": "https://fallback.example/mcp",
    "catalog": "https://fallback.example/catalog.json",
    "openapi": "https://fallback.example/openapi.json",
    "llms": "https://fallback.example/llms.txt",
    "llmsFull": "https://fallback.example/llms-full.txt",
    "serverCard": "https://fallback.example/.well-known/mcp/server-card.json",
    "x402": "https://fallback.example/.well-known/x402.json"
  },
  "tools": [
    {
      "id": "source_route",
      "version": "0.1.0",
      "name": "source_route",
      "description": "Find a practical, preferably authoritative and machine-readable route for obtaining information. Bounded deterministic discovery with at most one external search fallback.",
      "category": "source-discovery",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "format": "hostname",
            "pattern": "^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$"
          },
          "preferred_formats": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml",
                "rss",
                "api",
                "bulk_download",
                "html"
              ]
            }
          },
          "require_official": {
            "default": false,
            "type": "boolean"
          },
          "max_candidates": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "routes_found",
              "no_suitable_route_found",
              "insufficient_input"
            ]
          },
          "routes": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "route_type": {
                  "type": "string",
                  "enum": [
                    "official_api",
                    "openapi",
                    "bulk_download",
                    "structured_feed",
                    "dataset",
                    "developer_docs",
                    "structured_web",
                    "web"
                  ]
                },
                "format": {
                  "type": "string"
                },
                "publisher_match": {
                  "type": "string",
                  "enum": [
                    "exact_domain",
                    "linked_from_domain",
                    "search_discovered"
                  ]
                },
                "machine_readable": {
                  "type": "boolean"
                },
                "auth": {
                  "type": "string",
                  "enum": [
                    "none_observed",
                    "appears_required",
                    "unknown"
                  ]
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "reasons": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "url",
                "route_type",
                "publisher_match",
                "machine_readable",
                "auth",
                "score",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "checked": {
            "type": "object",
            "properties": {
              "direct_probes": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pages_fetched": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "search_queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "direct_probes",
              "pages_fetched",
              "search_queries"
            ],
            "additionalProperties": false
          },
          "limitations": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "routes",
          "checked",
          "limitations"
        ],
        "additionalProperties": false
      },
      "price": {
        "amount": "0.02",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "available",
      "httpRoute": "/v1/tools/source_route",
      "mcpName": "source_route",
      "examples": [
        {
          "title": "Find a machine-readable route",
          "input": {
            "goal": "Download the latest population dataset",
            "domain": "statistics.example"
          },
          "expected": "routes_found or no_suitable_route_found within checked scope"
        }
      ],
      "latencyTargetMs": 12000,
      "x402": {
        "resourceType": "http",
        "enabled": false,
        "discoveryExtension": "bazaar"
      },
      "distribution": {
        "apifyActorId": "fallback/source-route",
        "smitheryServerId": "source_route",
        "glamaServerId": "source_route"
      }
    },
    {
      "id": "stop_search",
      "version": "0.1.0",
      "name": "stop_search",
      "description": "Determine whether a bounded search has gathered enough negative evidence to reasonably stop. Planned and unavailable.",
      "category": "search-quality",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": {}
      },
      "price": {
        "amount": "0.02",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "planned",
      "httpRoute": "/v1/tools/stop_search",
      "mcpName": "stop_search",
      "examples": [
        {
          "title": "Planned schema placeholder",
          "input": {}
        }
      ],
      "latencyTargetMs": 1000,
      "x402": {
        "resourceType": "http",
        "enabled": false,
        "discoveryExtension": "bazaar"
      },
      "distribution": {
        "apifyActorId": "fallback/stop-search",
        "smitheryServerId": "stop_search",
        "glamaServerId": "stop_search"
      }
    },
    {
      "id": "error_route",
      "version": "0.1.0",
      "name": "error_route",
      "description": "Classify an API or tool failure and recommend a bounded next action. Planned and unavailable.",
      "category": "tool-recovery",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": {}
      },
      "price": {
        "amount": "0.002",
        "currency": "USD",
        "model": "pay-per-call"
      },
      "availability": "planned",
      "httpRoute": "/v1/tools/error_route",
      "mcpName": "error_route",
      "examples": [
        {
          "title": "Planned schema placeholder",
          "input": {}
        }
      ],
      "latencyTargetMs": 500,
      "x402": {
        "resourceType": "http",
        "enabled": false,
        "discoveryExtension": "bazaar"
      },
      "distribution": {
        "apifyActorId": "fallback/error-route",
        "smitheryServerId": "error_route",
        "glamaServerId": "error_route"
      }
    }
  ]
}
